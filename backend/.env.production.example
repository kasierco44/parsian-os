# Copy to .env in this directory on the deployment server. Never commit real values.
POSTGRES_DB=parsian_os
POSTGRES_USER=parsian_app
POSTGRES_PASSWORD=REPLACE_WITH_LONG_URL_SAFE_RANDOM_PASSWORD
JWT_SECRET=REPLACE_WITH_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
APP_VERSION=0.1.0
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=https://your-admin-domain.example
