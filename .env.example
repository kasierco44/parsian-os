# Copy to .env and replace all example secrets before deployment.
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_DATABASE_PASSWORD
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
APP_ENV=production
API_BIND_ADDRESS=127.0.0.1
API_PORT=8000
CORS_ORIGINS=https://your-parsian-domain.example
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_PASSWORD_AT_LEAST_12_CHARACTERS
BOOTSTRAP_ADMIN_NAME=مدیر سامانه
PARSIAN_NODE_ID=office-node-01
REPLICATION_PEER_NODE_ID=cloud-node-01
REPLICATION_PEER_URL=https://your-cloud-domain.example/api/v1
REPLICATION_SHARED_SECRET=REPLACE_WITH_SHARED_RANDOM_SECRET_AT_LEAST_32_BYTES
